# Auto-detect text files and perform LF normalization
* text=auto

# Explicitly declare text files to keep consistent line endings
*.ts text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Denote binary files (like ONNX models or images)
*.onnx binary
*.jpg binary
*.png binary
*.gif binary
